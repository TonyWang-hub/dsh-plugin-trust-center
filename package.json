{
  "name": "dsh-plugin-trust-center",
  "version": "0.3.1",
  "description": "Evidence-first inspection, compatibility verification, and quarantine tooling for DeepSeek Harness plugins.",
  "type": "module",
  "license": "Apache-2.0",
  "author": "TonyWang-hub",
  "repository": "github:TonyWang-hub/dsh-plugin-trust-center",
  "homepage": "https://tonywang-hub.github.io/dsh-plugin-trust-center/",
  "bugs": "https://github.com/TonyWang-hub/dsh-plugin-trust-center/issues",
  "engines": {
    "node": ">=24.17.0 <25"
  },
  "bin": {
    "dsh-trust": "./dist/cli.js"
  },
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./schema": "./schemas/passport.schema.json",
    "./schema/passport": "./schemas/passport.schema.json",
    "./schema/registry-source": "./schemas/registry-source.schema.json",
    "./schema/registry-report": "./schemas/registry-report.schema.json",
    "./plugin": {
      "types": "./dist/plugin.d.ts",
      "default": "./dist/plugin.js"
    }
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "dist/**/*.map",
    "schemas/*.json",
    "registry/sources.json",
    "site/*",
    "cordis.patch.yml",
    "docs/rules.md",
    "CHANGELOG.md",
    "README.md",
    "SECURITY.md",
    "LICENSE",
    "NOTICE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "oxlint src test",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "registry:build": "pnpm build && node dist/registry/build.js",
    "site:check": "node dist/site/check.js public",
    "test:dsh-bundle": "DSH_REAL_BUNDLE=1 vitest run test/dsh-bundle.acceptance.test.ts",
    "dogfood": "pnpm build && node dist/dogfood.js",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "tar": "7.5.22",
    "yaml": "2.9.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-tools": "0.1.0-rc.6"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh": "0.1.0-rc.6",
    "@deepseek-ai/dsh-tools": "0.1.0-rc.6",
    "@types/node": "24.13.3",
    "oxlint": "1.78.0",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  },
  "packageManager": "pnpm@11.21.0"
}
