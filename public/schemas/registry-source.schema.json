{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tonywang-hub.github.io/dsh-plugin-trust-center/schemas/registry-source.schema.json",
  "title": "DSH Community Registry Sources 1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "sources"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "sources": {
      "type": "array",
      "maxItems": 500,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/source" }
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["slug", "source", "name"],
      "properties": {
        "slug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 64 },
        "source": { "$ref": "#/$defs/sourceSpec" },
        "name": { "type": "string", "minLength": 1, "maxLength": 200 },
        "description": { "type": "string", "minLength": 1, "maxLength": 500 },
        "category": { "type": "string", "minLength": 1, "maxLength": 100 },
        "testedDshVersions": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 100,
          "items": {
            "type": "string",
            "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"
          }
        }
      }
    },
    "sourceSpec": {
      "type": "string",
      "pattern": "^(?:[^\\s:]+|npm:(?:@[a-z0-9._~-]+/)?[a-z0-9._~-]+@[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?|github:[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+#[0-9a-fA-F]{40})$"
    }
  }
}
